# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Dependencies (nunca no repo nem no zip — instaladas na máquina do usuário via `bun install`).
# Sem barra: pega diretórios E symlinks chamados node_modules, em qualquer nível.
node_modules
bun.lockb
package-lock.json
yarn.lock
.pnpm-store/

# Generated registries (created at runtime by `nrv index`)
.squads-registry.json
.businesses-registry.json
*.registry.json

# Audit logs (created at runtime, never in repo)
audit.jsonl
audit.db
*.audit.db
.harness-logs/
.nirvana/
# Dispatch run artifacts. A brief, a HANDOFF, whatever a business or squad
# produced, the generated report — the trace of using the engine, never the
# engine. Nine of these reached the public repo in #4 before anyone noticed.
outputs/

# Backups created by hooks/installer
*.bak.*
*.backup
*.backup.*

# User runtime data (must never enter the repo)
/squads/
/businesses/
/mind-clones/

# Build artifacts
dist/
build/
out/
*.log
.cache/

# Local secrets / env
.env
.env.local
.env.*.local

# Personal scratch
scratch/
tmp/
.sanitization-work/

# Internal docs (strategy, enforcement) — never public
/_private/

# Generated test reports (legacy router regression HTML)
skills/harness/tests/reports/

# Routing eval golden set — derived from the owner's PRIVATE live registries
# (example_briefs of squads/businesses). Rebuilt locally by
# skills/harness/scripts/build-golden-set.ts; only the hand-written
# golden-negatives.json is committed.
skills/harness/baselines/golden-routing.json

# The project-skeleton TEMPLATES are product files, not local state. The plain
# `.env` / `.nirvana/` patterns above swallowed them silently: they existed on
# the author's machine, never reached the repo, and every install shipped
# without them — while the tarball carries an allowlist expecting exactly
# these paths. (Field report, 2026-08-18.)
!skills/_shared/templates/project-skeleton/.env
!skills/_shared/templates/project-skeleton/.nirvana/
!skills/_shared/templates/project-skeleton/.nirvana/README.md
