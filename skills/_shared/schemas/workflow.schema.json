{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana-protocol/v6/schemas/workflow.schema.json",
  "title": "Workflow document",
  "description": "The canonical workflow graph (Squad Protocol v6 §28.1) — the frontmatter of workflows/<name>.md, as normalizeWorkflow() produces it.",
  "$comment": "GENERATED by scripts/gen-json-schemas.ts from skills/_shared/validators/validators.ts — do not edit by hand.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on_failure": {
            "type": "string",
            "enum": [
              "abort",
              "retry",
              "escalate",
              "continue"
            ]
          },
          "parallel_safe": {
            "type": "boolean"
          },
          "meta": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "agent",
          "requires",
          "creates",
          "meta"
        ],
        "additionalProperties": false
      }
    },
    "success_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "on_failure": {
      "type": "string",
      "enum": [
        "abort",
        "retry",
        "escalate",
        "continue"
      ]
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "steps",
    "extensions"
  ],
  "additionalProperties": false
}
