{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirvana-protocol/v6/schemas/capability.schema.json",
  "title": "Capability",
  "description": "One entry of squad.yaml capabilities[] (Squad Protocol v5 §22, v6 §29–§31 and §33).",
  "$comment": "GENERATED by scripts/gen-json-schemas.ts from skills/_shared/validators/validators.ts — do not edit by hand.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1500
    },
    "domains": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "string",
              "json",
              "array",
              "number",
              "boolean",
              "url"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schema": {
            "type": "string"
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "string",
              "json",
              "array",
              "markdown",
              "html",
              "binary"
            ]
          },
          "format": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "tools_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invoke": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "workflow",
            "task",
            "agent"
          ]
        },
        "ref": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "prompt_template": {
          "type": "string"
        },
        "inputs_mapping": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false
    },
    "examples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "produces": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      }
    },
    "example_briefs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 20,
        "maxLength": 1000
      }
    },
    "keywords": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "not_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "fidelity": {
      "type": "object",
      "properties": {
        "ground_truth_dir": {
          "type": "string"
        },
        "eval_results": {
          "type": "string"
        },
        "status": {
          "default": "experimental",
          "type": "string",
          "enum": [
            "validated",
            "experimental",
            "drifted",
            "retired"
          ]
        },
        "last_eval": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "judge_model": {
          "type": "string"
        },
        "threshold": {
          "default": 0.85,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "status",
        "threshold"
      ],
      "additionalProperties": false
    },
    "score_boost": {
      "default": 1,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "model_hint": {
      "default": "inherit",
      "type": "string",
      "enum": [
        "haiku",
        "sonnet",
        "opus",
        "inherit"
      ]
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "parallel_safe": {
      "default": false,
      "type": "boolean"
    },
    "writes_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributions": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "into": {
            "type": "string",
            "enum": [
              "employee",
              "squad",
              "mind_clone",
              "synthesizer"
            ]
          },
          "at": {
            "type": "string",
            "enum": [
              "plan:pre",
              "execute:pre",
              "execute:post",
              "verify:pre"
            ]
          },
          "fragment": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "inline": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "additionalProperties": false
          },
          "when": {
            "type": "string",
            "maxLength": 200
          },
          "produces": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consumes": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "into",
          "at",
          "fragment"
        ],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "minimumScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "scorecard": {
          "type": "string",
          "minLength": 1
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "scorecard",
        "rubric"
      ],
      "additionalProperties": false
    },
    "requires": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z][a-z0-9-]{1,63}:)?[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$"
      }
    },
    "consumes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      }
    }
  },
  "required": [
    "id",
    "description",
    "domains",
    "invoke",
    "examples",
    "score_boost",
    "model_hint",
    "parallel_safe"
  ],
  "additionalProperties": false
}
