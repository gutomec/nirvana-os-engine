# ─────────────────────────────────────────────────────────────────────
# Capability Block — snippet para colar dentro de capabilities[] em squad.yaml
# Squad Protocol v5 §22 / v6 §29-§33. Schema: capability.schema.json (generated).
# ─────────────────────────────────────────────────────────────────────

  - id: {{CAPABILITY_ID}}
    # ^^^ dotted hierarchical, ≥3 segmentos. Ex: marketing.funnel.create,
    # media.video.analyze, sales.pricing.optimize. Padrão snake_case
    # por segmento. Pattern: ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*){2,}$

    description: >
      {{CAPABILITY_DESCRIPTION}}
    # ^^^ 20-1500 chars (LIMITS.capability_description_max). Diga o que entrega em termos concretos. Esta string
    # alimenta o BM25 da discovery — escreva como se fosse buscar você mesmo.

    domains: [{{DOMAIN_1}}, {{DOMAIN_2}}]
    # ^^^ 1-5 domains de ~/.claude/skills/_shared/catalogs/CAPABILITY_CATALOG_V1.yaml.
    # Ex: [marketing, sales], [media, video], [strategy, analytics].
    # Domínios fora do catálogo exigem `experimental_domains: true` na squad.

    inputs:
      - name: {{INPUT_NAME}}
        type: string                        # file|string|json|array|number|boolean|url
        formats: [text, markdown]           # opcional, hint p/ runtime
        required: true
        description: "{{INPUT_DESCRIPTION}}"

    outputs:
      - name: {{OUTPUT_NAME}}
        type: markdown                      # file|string|json|array|markdown|html|binary
        format: structured
        description: "{{OUTPUT_DESCRIPTION}}"
        # schema: schemas/{{OUTPUT_NAME}}.json   # opcional, p/ outputs JSON

    tools_required:
      - read
      - write
      - web_search
    # ^^^ semantic tool names (Squad v4 §10.7). Adapter traduz para nomes nativos.

    invoke:
      type: workflow                        # workflow | task | agent
      ref: workflows/{{WORKFLOW_OR_TASK_REF}}
      # Para type=task: adicione `agent: {{AGENT_NAME}}` se quiser fixar.
      # Para type=agent: adicione `prompt_template: "..."` (opcional).
      # inputs_mapping: opcional, mapeia capability inputs → invoke target inputs.

    examples:
      - "{{NL_INTENT_1}}"
      - "{{NL_INTENT_2}}"
      - "{{NL_INTENT_3}}"
    # ^^^ >=1 mandatory. Natural phrases that must match this capability.
    # Cover variations: PT-BR, EN, formal, informal, synonyms.

    # ── Routing metadata — ROUTING_METADATA_CONTRACT.md. Fill ALL, then run the
    # self-retrieval gate (blocking): creation is NOT done until it exits 0.
    #   bun ~/.claude/skills/_shared/scripts/self-retrieval-gate.ts <squad-slug>

    produces:
      - todo-artifact-type
    # ^^^ artifact-type slugs, kebab-case, 3-80 chars (§3). One slug per artifact
    # type; synonyms belong in keywords, not here.

    keywords:
      - "TODO concept in English"
      - "TODO conceito em português"
      - "TODO conceito em portugues"
    # ^^^ multilingual synonym GROUPS (§4): each concept ships EN + PT (+ES where
    # natural), accented AND unaccented forms. Indexed x3 — the strongest signal.

    example_briefs:
      - "TODO: EN brief phrased as a real user ask, conjugated verb form"
      - "TODO: brief PT como o dono escreveria em pânico, verbo conjugado"
      - "TODO: brief cobrindo a forma no infinitivo (quero escrever... / write...)"
    # ^^^ >=3; at least one EN and one PT; symptom language, both conjugated and
    # infinitive verb forms (§5). These feed the golden set AND the gate. Never
    # put this squad's own slug inside a brief.

    not_for:
      - "todo refused territory"
    # ^^^ short token lists: 2-4 content words per entry, min 5 chars (§6). NEVER
    # sentences, no "(use X instead)" suffixes — the router penalty is a substring
    # match against the brief, and anything appended makes the entry unmatchable.
    # EN and PT as separate entries; accented and unaccented as separate entries.

    fidelity:
      status: experimental                  # validated | experimental | drifted | retired
      threshold: 0.85                       # 0-1, score mínimo p/ aceitar saída
      # ground_truth_dir: evals/{{CAPABILITY_ID}}/    # opcional
      # eval_results: evals/{{CAPABILITY_ID}}/results.json
      # last_eval: 2026-05-01T00:00:00Z
      # judge_model: claude-opus-4-7

    score_boost: 1.0
    # ^^^ 0.0-2.0. Multiplica score na discovery.
    # Convenção: validated=1.0, experimental=0.85, drifted=0.5, retired=0.

    model_hint: sonnet                      # haiku | sonnet | opus | inherit

    estimated_cost_usd: 0.50
    # ^^^ self-reported, opcional. Harness usa p/ budget pre-flight.

    # acceptance:                          # opcional (v6 §29): como o output é julgado.
    #   - id: offer_stated                  # Sem ele, o juiz cai nos "## Acceptance Criteria"
    #     description: ...                  # da task invocada.
    #     blocking: true
