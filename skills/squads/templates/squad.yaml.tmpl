# ─────────────────────────────────────────────────────────────────────
# Squad Manifest — Squad Protocol v6.0 (capabilities-aware, Markdown workflows)
# Substitua todos os {{PLACEHOLDERS}} antes de fazer commit.
# Portão:  nrv validate squad <dir>          (admissão; --fix aplica os reparos mecânicos)
# Schema:  ~/.nirvana/skills/_shared/schemas/capability.schema.json  (gerado de validators.ts)
# ─────────────────────────────────────────────────────────────────────

name: {{SQUAD_NAME}}                      # kebab-case, ^[a-z][a-z0-9-]+$
version: "1.0.0"                          # semver MAJOR.MINOR.PATCH
protocol: "6.0"                           # 6.0 = workflow em Markdown (§28). 5.0 continua válido.
description: "{{DESCRIPTION}}"            # ≥20 caracteres, descreva o que a squad entrega
author: "{{AUTHOR}}"
license: SUL-1.0
slashPrefix: {{PREFIX}}                   # 2-4 chars, ex: sfm, ig, mk
tags: [{{TAG_1}}, {{TAG_2}}]              # busca livre

# ─────────────────────────────────────────────────────────────────────
# Capabilities (Squad v5 §22, v6 §29-§33) — OBRIGATÓRIO em v5 e v6
# Cada capability mapeia uma intenção do usuário (NL) para um workflow,
# task ou agent dentro desta squad. Sem capabilities[], a squad fica
# invisível à descoberta do harness.
# ─────────────────────────────────────────────────────────────────────
capabilities:
  - id: {{CAPABILITY_ID}}                 # dotted, >=3 segments. Ex: marketing.funnel.create
    description: >
      {{CAPABILITY_DESCRIPTION}}          # 20-1500 chars, canonical ENGLISH, concrete and
                                          # front-loaded (contract §1). Never truncate.
    domains: [{{CAPABILITY_DOMAINS}}]     # 1-5 domains from CAPABILITY_CATALOG_V1.yaml
    invoke:
      type: workflow                      # workflow | task | agent
      ref: workflows/{{WORKFLOW_REF}}     # v6 §28.6: sem extensão — a ref nomeia o workflow,
                                          # não a codificação. Com `.md`/`.yaml` é erro em 6.0.
    examples:
      - "{{EXAMPLE_INTENT_1}}"            # NL phrases that must match (>=1 mandatory)
      - "{{EXAMPLE_INTENT_2}}"
      - "{{EXAMPLE_INTENT_3}}"
    # ── Routing metadata (ROUTING_METADATA_CONTRACT.md) — fill ALL fields, then
    #    run the self-retrieval gate; creation is NOT done until it passes:
    #    bun ~/.claude/skills/_shared/scripts/self-retrieval-gate.ts <squad-slug>
    produces:                             # artifact-type slugs, kebab-case (§3)
      - todo-artifact-type                # TODO: e.g. ebook, landing-page, promo-video
    keywords:                             # multilingual synonym groups (§4) — TODO: replace.
      # Each concept ships EN + PT (+ES where natural), accented AND unaccented:
      - "TODO concept in English"
      - "TODO conceito em português"
      - "TODO conceito em portugues"      # unaccented variant of the same concept
    example_briefs:                       # >=3; >=1 EN and >=1 PT; symptom-phrased (§5)
      - "TODO: EN brief phrased as a real user ask, conjugated verb form"
      - "TODO: brief PT como o dono escreveria em pânico, verbo conjugado"
      - "TODO: brief cobrindo a forma no infinitivo (quero escrever... / write...)"
    not_for:
      - "todo refused"                    # v6 §33: <=25 chars, 2-4 content words, no id suffix.
      # NEVER sentences, no "(use X)" suffixes — the penalty is a substring match,
      # and above 25 chars BM25 needs 60% token overlap, so the fence stops firing.
      # EN and PT are separate entries; accented and unaccented are separate entries.
    outputs:
      - name: {{OUTPUT_NAME}}             # snake_case
        type: markdown                    # file|string|json|array|markdown|html|binary
        description: "{{OUTPUT_DESCRIPTION}}"
    # ── Aceitação (v6 §29) — o que o juiz cobra desta capability. Deriva de
    #    `success_indicators` do workflow com `nrv migrate --to 6`; escrever à
    #    mão é igualmente válido. Máx 12; `brief-conformance` vem sempre antes.
    acceptance:
      - id: todo_acceptance_id            # ^[a-z][a-z0-9_-]*$, único na squad
        description: "TODO: critério binário e verificável do entregável"
        blocking: true
    fidelity:
      status: experimental                # experimental | validated | drifted | retired
      threshold: 0.85
    score_boost: 1.0                      # 0.0-2.0; harness multiplica score de discovery
    model_hint: sonnet                    # haiku | sonnet | opus | inherit
    estimated_cost_usd: 0.50              # opcional, usado para budget pre-flight

  # Adicione mais capabilities seguindo o snippet em
  # ~/.claude/skills/squads/templates/capability-block.tmpl

# ─────────────────────────────────────────────────────────────────────
# Components (Squad v4 §5) — preservado em v5
# ─────────────────────────────────────────────────────────────────────
components:
  agents:
    - {{AGENT_1}}.md
    - {{AGENT_2}}.md
  tasks:
    - {{TASK_1}}.md
    - {{TASK_2}}.md
  workflows:
    - {{WORKFLOW_REF}}                    # §28.6: sem extensão, como o `invoke.ref`

# ─────────────────────────────────────────────────────────────────────
# Runtime Requirements (Squad v4 §6 + v5 App-D)
# Sem deps externas. Adapters em ~/.claude/skills/_shared/adapters/.
# ─────────────────────────────────────────────────────────────────────
runtime_requirements:
  policy: active
  minimum:
    - { runtime: claude-code, version: ">=1.0.0" }
  compatible:
    - { runtime: codex, version: ">=0.20.0" }
    - { runtime: gemini-cli, version: ">=0.4.0" }
  incompatible: []

features_required:
  - max_turns
  - tool_whitelist
  - subagent_spawning
  - handoff_artifacts

features_optional:
  - hooks
  - audit_trail
  - telemetry_otel

# ─────────────────────────────────────────────────────────────────────
# Output convention (Squad v4 §16bis)
# `default` = .squads-outputs/{squad-name}/{timestamp}-{slug}/
# Custom path: base_dir: ./my-output-folder
# ─────────────────────────────────────────────────────────────────────
output:
  base_dir: default
