{
  "name": "nirvana-os",
  "version": "0.7.8",
  "private": true,
  "description": "The Operating System for agentic work — runtime-agnostic, local-first agent control plane.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Luiz Gustavo Vieira Rodrigues (https://github.com/gutomec)",
  "homepage": "https://squads.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gutomec/nirvana-os-engine.git"
  },
  "bugs": {
    "url": "https://github.com/gutomec/nirvana-os-engine/issues"
  },
  "keywords": [
    "agent-os",
    "agent-orchestration",
    "ai-agents",
    "control-plane",
    "claude-code",
    "gemini-cli",
    "codex",
    "antigravity",
    "hermes",
    "squads",
    "businesses",
    "mind-clones",
    "skills",
    "mcp",
    "audit",
    "observability"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "python": ">=3.10"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.0"
  },
  "scripts": {
    "install:system": "bun scripts/install.ts",
    "test": "bun test skills",
    "validate": "bun skills/_shared/scripts/validate-mind-clones.ts && bun skills/harness/scripts/validate.ts",
    "glance": "bun skills/harness/scripts/glance.ts",
    "check:dispatch": "bun scripts/check-dispatch-contract.ts",
    "check:purity": "bun scripts/check-engine-purity.ts",
    "check:english": "bun scripts/check-english-source.ts --strict",
    "check:coverage": "bun skills/_shared/scripts/coverage-ratchet.ts --check --strict",
    "check:notfor": "bun scripts/check-not-for-fires.ts",
    "check:clones": "bun scripts/check-capability-clones.ts --strict",
    "check:bindings": "bun scripts/check-clone-bindings.ts --strict",
    "check:packs": "bun scripts/check-published-packs.ts --strict",
    "check:audit-parity": "bun scripts/check-audit-parity.ts --strict",
    "check:command-parity": "bun scripts/check-skillmd-command-parity.ts --strict",
    "check:changelog": "bun scripts/check-changelog-parity.ts --strict",
    "check:version": "bun scripts/check-version-parity.ts --strict",
    "check:all": "bun scripts/check-skillmd-command-parity.ts --strict && bun scripts/check-audit-parity.ts --strict && bun scripts/check-english-source.ts --strict && bun scripts/check-changelog-parity.ts --strict && bun scripts/check-version-parity.ts --strict && bun skills/_shared/scripts/coverage-ratchet.ts --check --strict && bun scripts/check-not-for-fires.ts --strict && bun scripts/check-capability-clones.ts --strict && bun scripts/check-clone-bindings.ts --strict && bun scripts/check-engine-purity.ts && bun scripts/sync-agent-docs.ts --check && bun scripts/check-dispatch-contract.ts"
  }
}
