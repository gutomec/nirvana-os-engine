#!/usr/bin/env bash
# nrv — master entry point for Nirvana harness commands.
#
# Sub-commands map directly to the canonical scripts under
# ~/.claude/skills/harness/scripts/ and ~/.claude/skills/_shared/scripts/.
#
# Usage:
#   nrv glance [--allow-actions]          → web cockpit (alias of `glance`)
#   nrv route "<brief>"                   → route a brief through the harness
#   nrv use-businesses "<brief>"          → route forcing business-first preference
#   nrv use-squads "<brief>"              → route forcing squad-first preference
#   nrv find "<query>"                    → dry-run capability discovery
#   nrv validate <kind> <slug|path>       → admission gate (squad|business|mind-clone); bare = deprecated doctor alias
#   nrv migrate <slug> --to 6 [--apply]   → convert a squad to Squad Protocol 6.0 (dry-run by default)
#   nrv index                             → re-index squads + businesses
#   nrv deps [scan|adopt|link|install|env] → the one home every dependency installs into (~/.nirvana)
#   nrv config list|get|set|unset|explain → operational settings (value + origin per key)
#   nrv init <target_dir> [--copy]        → bootstrap a new Nirvana project
#   nrv validate-mind-clones              → audit the mind-clone library (alias of validate mind-clone --all)
#   nrv help                              → list all sub-commands

set -euo pipefail

# Neutral shared skills root: prefer ~/.nirvana/skills (shared across all
# runtimes), fall back to legacy ~/.claude/skills. Override via NIRVANA_SKILLS_DIR.
SKILLS="${NIRVANA_SKILLS_DIR:-$([ -d "$HOME/.nirvana/skills" ] && echo "$HOME/.nirvana/skills" || echo "$HOME/.claude/skills")}"

if command -v bun >/dev/null 2>&1; then
  BUN_BIN="bun"
elif [ -x "$HOME/.bun/bin/bun" ]; then
  BUN_BIN="$HOME/.bun/bin/bun"
else
  # Bun IS the runtime: every subcommand below ends in `exec "$BUN_BIN"`, so a
  # missing binary is the end of the road. "bun not found" was the whole message,
  # which left anyone whose ~/.bun was wiped (new machine, cleaned PATH) with the
  # bare fact and no way out. setup.sh already answers this well; the launcher is
  # where the same person lands AFTER the install, and it said nothing.
  #
  # Name the command for THIS system rather than listing every platform: a reader
  # who has to pick can pick wrong, and a wrong pick is a second failure. Git Bash
  # reports MINGW/MSYS/CYGWIN from `uname -s` and needs the PowerShell installer,
  # not the curl one.
  echo "nrv: bun not found. Nirvana-OS runs on Bun." >&2
  case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
      echo "  Install it, then run nrv again:" >&2
      echo '    powershell -c "irm bun.sh/install.ps1 | iex"' >&2
      echo "  If the execution policy blocks that, install it with winget:" >&2
      echo "    winget install Oven-sh.Bun" >&2 ;;
    *)
      echo "  Install it, then run nrv again:" >&2
      echo "    curl -fsSL https://bun.sh/install | bash" >&2
      echo "  NEVER use 'npm install -g bun' (EACCES in /usr/local)." >&2 ;;
  esac
  echo "  Already installed? Open a new terminal, or put ~/.bun/bin on your PATH." >&2
  exit 1
fi

cmd="${1:-help}"
shift || true

# ── update awareness ─────────────────────────────────────────────────────────
# Every subcommand below ends in `exec`, so there is no "after the command" to
# hook: the notice has to come BEFORE, and it must cost nothing. It therefore
# reads a cache file (one stat, one read) written by a DETACHED refresher that
# benefits the NEXT invocation, never this one. Contract and rationale live in
# skills/harness/scripts/update-check.ts.
#
# Silence is the failure mode: a missing cache, an unreadable file, no network,
# a stat that behaves differently on this OS — each results in no message, never
# in a broken command.
nrv_update_notice() {
  if [ -n "${NIRVANA_NO_UPDATE_CHECK:-}" ] || [ -n "${CI:-}" ]; then return 0; fi
  case "$cmd" in
    update|self-update|upgrade|version|--version|-v|-V) return 0 ;;
  esac

  notice_file="$HOME/.nirvana/cache/update-notice.txt"

  checked_at=0; latest_seen=""; notice_msg=""
  # Three builtin reads, no subprocess: this runs before EVERY command, so a
  # handful of forks here would be a tax on the entire CLI.
  if [ -r "$notice_file" ]; then
    { read -r checked_at || true; read -r latest_seen || true; read -r notice_msg || true; } < "$notice_file"
  fi
  # A corrupted first line must never reach arithmetic: `$(( ))` on garbage is a
  # hard shell error, which under `set -e` would take the whole command down.
  case "$checked_at" in ''|*[!0-9]*) checked_at=0 ;; esac

  # Print only on an interactive stderr, and only when the cached version is not
  # the one already installed — someone who just updated must stop seeing it at
  # once, without waiting for the next refresh. stderr keeps stdout parseable.
  # NIRVANA_UPDATE_CHECK_ASSUME_TTY is a TEST seam: the print path is gated on an
  # interactive stderr, which a test harness (a pipe) can never satisfy.
  if [ -n "$latest_seen" ]; then
    if [ -t 2 ] || [ -n "${NIRVANA_UPDATE_CHECK_ASSUME_TTY:-}" ]; then
      installed_now=""
      if [ -r "$SKILLS/VERSION" ]; then read -r installed_now < "$SKILLS/VERSION" || true; fi
      if [ "$latest_seen" != "$installed_now" ]; then
        printf '%s\n' "$notice_msg" >&2
      fi
    fi
  fi

  # Refresh when the cache is missing or a day old. EPOCHSECONDS is a bash 5
  # builtin; macOS still ships bash 3.2, so fall back to `date` there — the one
  # fork left, and only on that platform. Measured on this path: ~2.6 ms with
  # the fork (bash 3.2), ~0 without (bash >= 5), against 30 ms+ for the bun
  # startup that follows every real subcommand.
  now="${EPOCHSECONDS:-}"
  if [ -z "$now" ]; then now=$(date +%s); fi
  if [ $(( now - checked_at )) -ge 86400 ]; then
    # The subshell + & detaches: this shell is about to exec, and the child
    # reparents instead of dying with it.
    ( "$BUN_BIN" "$SKILLS/harness/scripts/update-check.ts" --refresh >/dev/null 2>&1 & ) 2>/dev/null || true
  fi
  return 0
}
nrv_update_notice || true

case "$cmd" in
  update-check)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/update-check.ts" "${@:---status}" ;;
  version|--version|-v|-V)
    if [ -f "$SKILLS/VERSION" ]; then
      v=$(cat "$SKILLS/VERSION")
    elif [ -f "$SKILLS/../package.json" ]; then
      v=$(grep -m1 '"version"' "$SKILLS/../package.json" | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
    else
      v="unknown"
    fi
    edition="Nirvana-OS"
    [ -f "$SKILLS/EDITION" ] && edition=$(cat "$SKILLS/EDITION")
    printf 'nrv %s (%s)\n' "$v" "$edition" ;;
  glance)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/glance.ts" "$@" ;;
  route)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/route.ts" "$@" ;;
  use-businesses|business|businesses)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/route.ts" "$@" --prefer business ;;
  use-squads|squad|squads)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/route.ts" "$@" --prefer squad ;;
  find)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/find.ts" "$@" ;;
  validate|verify)
    # the admission gate; bare `nrv validate` still runs the doctor with a deprecation notice
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/verify.ts" "$@" ;;
  watch|tail)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/watch.ts" "$@" ;;
  watch-fs|fswatch)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/watch-fs.ts" "$@" ;;
  index)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/index.ts" "$@" ;;
  config)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/config.ts" "$@" ;;
  pack-manifest|gen-pack-manifest)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/gen-pack-manifest.ts" "$@" ;;
  init|init-project)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/init-project.ts" "$@" ;;
  install)
    # nrv install — overloaded: with --bootstrap routes to the system installer.
    # Default routes to the asset installer (Tier 0/1: businesses, squads, mind-clones, packs).
    if [[ "${1:-}" == "--bootstrap" || "${1:-}" == "--check" || "${1:-}" == "--starter" || "${1:-}" == "--no-starter" || "${1:-}" == "--dry" || "${1:-}" == "--repair-path" ]]; then
      exec "$BUN_BIN" "$SKILLS/_shared/scripts/install.ts" "$@"
    fi
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/install-asset.ts" "$@" ;;
  setup)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/install.ts" "$@" ;;
  uninstall)
    # nrv uninstall <name>     → remove an installed asset (squad/business/clone/pack)
    # nrv uninstall --engine   → remove the engine (skills+CLI+links+hooks); keeps content
    # nrv uninstall --hooks    → remove only the audit hooks
    if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
      # Pack pago (Trilha A: ~/.nirvana/packs/<slug>.json) tem precedência sobre
      # o asset registry (Trilha B), e --kind=pack força.
      if [ -f "$HOME/.nirvana/packs/${1}.json" ] || [[ " $* " == *" --kind=pack "* ]]; then
        exec "$BUN_BIN" "$SKILLS/_shared/scripts/uninstall-pack.ts" "$@"
      fi
      exec "$BUN_BIN" "$SKILLS/_shared/scripts/uninstall-asset.ts" "$@"
    fi
    case "${1:-}" in
      --engine)
        shift; exec "$BUN_BIN" "$SKILLS/_shared/scripts/uninstall-engine.ts" "$@" ;;
      --hooks)
        shift; exec "$BUN_BIN" "$SKILLS/_shared/scripts/install.ts" --uninstall "$@" ;;
      *)
        echo "usage: nrv uninstall <name>      remove an installed asset"
        echo "       nrv uninstall --engine    remove the engine (keeps ~/squads, ~/businesses)"
        echo "       nrv uninstall --hooks      remove only the audit hooks"
        exit 2 ;;
    esac ;;
  installed|list-installed)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/list-installed.ts" "$@" ;;
  validate-mind-clones|mc-validate)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/validate-mind-clones.ts" "$@" ;;
  validate-trace|trace-validate)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/validate-trace.ts" "$@" ;;
  baseline)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/baseline.ts" "$@" ;;
  improver)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/improver.ts" "$@" ;;
  embeddings|embedder)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/embeddings.ts" "$@" ;;
  guard)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/guard.ts" "$@" ;;
  fix-squad|doctor-squad)
    exec "$BUN_BIN" "$SKILLS/squads/scripts/fix-squad.ts" "$@" ;;
  migrate|migrate-squad)
    # v5 -> v6 conversion; dry-run by default, --apply writes, --rollback <ts> restores
    exec "$BUN_BIN" "$SKILLS/squads/scripts/migrate-squad.ts" "$@" ;;
  memory|mem)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/memory.ts" "$@" ;;
  gate)
    # nrv gate <rubric> <args>… — currently only voice-fidelity is wired
    case "${1:-}" in
      voice-fidelity|voice|mind-clone-voice-fidelity)
        shift; exec "$BUN_BIN" "$SKILLS/harness/scripts/gate-voice-fidelity.ts" "$@" ;;
      *)
        echo "usage: nrv gate <rubric> <args>"
        echo "available rubrics: voice-fidelity"
        exit 2 ;;
    esac ;;
  deps)
    # nrv deps [status|scan|adopt|link|install|env] — the single dependency home
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/deps.ts" "$@" ;;
  doctor|capability-doctor)
    # nrv doctor [--system|--capability]
    case "${1:-system}" in
      --capability|capability) shift; exec "$BUN_BIN" "$SKILLS/_shared/scripts/capability-doctor.ts" "$@" ;;
      --system|system|"") exec "$BUN_BIN" "$SKILLS/harness/scripts/doctor-system.ts" "$@" ;;
      *) exec "$BUN_BIN" "$SKILLS/harness/scripts/doctor-system.ts" "$@" ;;
    esac ;;
  dispatch)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/dispatch.ts" "$@" ;;
  team)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/chain.ts" "$@" ;;
  run|autopilot)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/dispatch.ts" "$@" --exec ;;
  auto)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/dispatch.ts" "$@" --exec --auto ;;
  revise)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/revise.ts" "$@" ;;
  run-track)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/run-track.ts" "$@" ;;
  multi-target|mt)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/multi-target.ts" "$@" ;;
  supervisor)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/supervisor.ts" "$@" ;;
  clean|clean-project|purge)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/clean-project.ts" "$@" ;;
  update|self-update|upgrade)
    # nrv update            → atualiza o ENGINE (git pull / re-fetch do release)
    # nrv update <slug>     → atualiza um PACK pago instalado (--check só compara)
    if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
      exec "$BUN_BIN" "$SKILLS/_shared/scripts/update-pack.ts" "$@"
    fi
    exec "$BUN_BIN" "$SKILLS/harness/scripts/update.ts" "$@" ;;
  install-content)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/install-content.ts" "$@" ;;
  pack)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/pack.ts" "$@" ;;
  audit-view|audit)
    if [ "${1:-}" = "emit" ]; then
      shift; exec "$BUN_BIN" "$SKILLS/harness/scripts/audit-emit.ts" "$@"
    fi
    exec "$BUN_BIN" "$SKILLS/harness/scripts/audit-view.ts" "$@" ;;
  search)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/search.ts" "$@" ;;
  export)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/export.ts" "$@" ;;
  ask)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/ask.ts" "$@" ;;
  launch)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/launch.ts" "$@" ;;
  tui|cockpit-tui)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/tui.ts" "$@" ;;
  activate|activate-squad|squad-activate)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/activate.ts" "$@" ;;
  serve|api|server)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/serve.ts" "$@" ;;
  graph|entity-graph)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/graph.ts" "$@" ;;
  validate-chain|chain-validate|chain)
    exec "$BUN_BIN" "$SKILLS/harness/scripts/validate-chain.ts" "$@" ;;
  resume|resume-project)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/resume-project.ts" "$@" ;;
  list-squads|squads-list)
    exec "$BUN_BIN" "$SKILLS/squads/scripts/list-squads.ts" "$@" ;;
  list-businesses|businesses-list)
    exec "$BUN_BIN" "$SKILLS/businesses/scripts/list-businesses.ts" "$@" ;;
  list-clones|clones-list|list-mind-clones|mind-clones)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/list-clones.ts" "$@" ;;
  inspect-clone|clone-inspect|inspect-mind-clone)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/inspect-clone.ts" "$@" ;;
  find-clone|clone-find|find-mind-clone)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/find-clone.ts" "$@" ;;

  changes|surface)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/nirvana-changes.ts" "$@" ;;
  validate-starter|starter-validate)
    # Dev-only: validates a starter/content pack inside the PACKS repo
    # (NIRVANA_PACKS_DIR, default ~/nirvana-packs). This script is not shipped
    # in installed copies, so guard the path and fail with a clear message
    # instead of a raw "module not found".
    NIRVANA_PACKS_DIR="${NIRVANA_PACKS_DIR:-$HOME/nirvana-packs}"
    if [ -f "$NIRVANA_PACKS_DIR/scripts/validate-starter.ts" ]; then
      exec "$BUN_BIN" "$NIRVANA_PACKS_DIR/scripts/validate-starter.ts" "$@"
    fi
    echo "nrv validate-starter: dev-only command (requires the packs repo at ~/nirvana-packs, or set NIRVANA_PACKS_DIR)." >&2
    exit 2 ;;
  license|verify-license|whoami)
    exec "$BUN_BIN" "$SKILLS/_shared/scripts/license.ts" "$@" ;;
  help|-h|--help|"")
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -f "$SKILLS/harness/assets/octo.ansi" ]; then
      printf '\n'
      cat "$SKILLS/harness/assets/octo.ansi"
      printf '  \033[1;38;2;230;57;53mNirvana-OS\033[0m  \033[2m·  command a universe of companies\033[0m\n\n'
    fi
    exec "$BUN_BIN" "$SKILLS/harness/scripts/help.ts"
    ;;
  *)
    echo "nrv: unknown subcommand '$cmd'" >&2
    echo "     run 'nrv help' to list available commands" >&2
    exit 2 ;;
esac
